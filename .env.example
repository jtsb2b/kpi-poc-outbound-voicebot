# Copy to .env (never commit .env). All values below are local-development defaults.

# Operator login for the UI and API (generate a long random value, e.g. `openssl rand -hex 24`)
OPERATOR_TOKEN=change-me-to-a-long-random-value

# MongoDB. Default assumes the project-local native mongod on port 27018 (see README).
MONGO_URI=mongodb://127.0.0.1:27018
MONGO_DB=kpi_voicebot

API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Results, transcripts and events expire after this many days (MongoDB TTL)
RETENTION_DAYS=30

# Real phone calls over LiveKit SIP (UI live mode, worker, kpi-call). Off until you are ready to dial.
LIVE_CALLS_ENABLED=false
CALLING_START_HOUR=8
CALLING_END_HOUR=20
TIMEZONE=Asia/Bangkok
ALLOW_INTERNAL_EXTENSIONS=false   # true lets you dial 3–5 digit PBX extensions for tests

# Text simulator pacing (ms between turns) and worker lease
SIM_TURN_DELAY_MS=700
LEASE_SECONDS=30

# ---- Speech recognition (chosen explicitly; never a silent fallback) ----
# soniox = Soniox real-time stt-rt-v5 (while JaiASR is in maintenance); jai = JaiASR-Flash
ASR_PROVIDER=soniox
SONIOX_API_KEY=
# SONIOX_MODEL=stt-rt-v5
# SONIOX_MAX_ENDPOINT_DELAY_MS=800

# ---- Reply understanding + wording (self-hosted OpenThai 2.0 27B, OpenAI-compatible JTS gateway) ----
# rules = deterministic only (no network); llm = LLM reading with the rule safety layer on top
INTERPRETER=rules
# With INTERPRETER=llm: agent = the LLM leads the conversation from the knowledge base (default);
# scripted = the engine's approved lines, reworded by the LLM
CONVERSATION_MODE=agent
LLM_BASE_URL=https://api.jasgpu.com/v1
LLM_API_KEY=
LLM_MODEL=session-tenant-a-openthai2-27b
# previous: LLM_MODEL=session-tenant-a-qwen38-flash-next-fp8
LLM_TIMEOUT_SECONDS=8
# Client-side budget below the gateway quota; 0 = no limit. A turn never queues more than
# LLM_MAX_QUEUE_SECONDS (0.3) for it: over budget, the approved wording is said instead.
LLM_REQUESTS_PER_MINUTE=60
LLM_TOKENS_PER_MINUTE=0

# ---- JaiASR-Flash-v1.0 (used when ASR_PROVIDER=jai) ----
JAIASR_API_KEY=
JAIASR_MODEL=session-tenant-ai-engineer-jaiasr-flash-v1
ASR_CHUNK_SECONDS=0.5

# ---- Voice: JAI TTS (default) ----
TTS_PROVIDER=jai
JAITTS_BASE_URL=https://jai-tts.bai-ap.jts.co.th:10206
JAITTS_API_KEY=
JAITTS_CFG=2.0
JAITTS_TEMPERATURE=0.7
TTS_CACHE_DIR=.local/tts_cache

# ---- Optional: Gemini Live voice (only with TTS_PROVIDER=gemini) ----
GOOGLE_API_KEY=
TTS_MODEL=gemini-3.8-live
TTS_VOICE=Sulafat

# ---- Phone calls (LiveKit Cloud SIP); also set LIVE_CALLS_ENABLED=true ----
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=ST_NbZaAsMDs5Br
LIVEKIT_AGENT_NAME=kpi-voicebot-outbound
LIVEKIT_ROOM_PREFIX=kpi-
SIP_CALLER_NUMBER=2211
SIP_DESTINATION_FORMAT=national
PUBLIC_CALLER_ID=+6621004148
# SIP_RINGING_TIMEOUT_SECONDS=30
# MAX_CALL_SECONDS=600
# PHONE_NOISE_CANCELLATION=ai_coustics   # as the inbound bot (QUAIL_VF_S); krisp | none
# Call recording (approved by PM 2026-10-08): Tencent COS (S3-compatible). Recording is on when all four are set.
# COS_REGION e.g. ap-bangkok; COS_BUCKET is <name>-<appid>
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_REGION=
# COS_BUCKET=
# COS_PREFIX=kpi-voicebot/recordings/
